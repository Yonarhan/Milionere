# Copie para .env (fica fora do git) e ajuste. Tudo é opcional: sem .env valem os padrões.
# MILIONERE_VOZ=edge            # edge (MVP) | azure (mesma voz, oficial: antes de cobrar)
# MILIONERE_LLM=claude-cli      # claude-cli (dev) | api (API direta da Anthropic)
# ANTHROPIC_API_KEY=            # console.anthropic.com -> API Keys (só aqui, nunca no git)
# MILIONERE_MODELO_ROTEIRO=sonnet   # haiku | sonnet | opus (ou o ID completo)
# MILIONERE_MODELO_JUIZ=haiku
# MILIONERE_ESFORCO_ROTEIRO=medium  # low | medium | high (só API; o Haiku ignora)
# MILIONERE_ESFORCO_JUIZ=low
# MILIONERE_IMAGEM=auto         # auto | comfy | gemini | manual
# MILIONERE_PLANO=gratis        # gratis | pago | chave_propria
# MILIONERE_COMFY=/home/rafael/projects/milionere/ComfyUI
# MILIONERE_CHAVE_GEMINI=       # só para o plano chave_propria (o Django define por job)
